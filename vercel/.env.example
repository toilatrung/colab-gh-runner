# ---- Bí mật dùng chung (tạo bằng: openssl rand -hex 24) ----
HEARTBEAT_SECRET=          # Colab -> /api/heartbeat (cũng là Colab Secret HEARTBEAT_SECRET)
CHECK_SECRET=              # cron-job.org -> /api/check?key=...
AGENT_TOKEN=               # webapp local -> /api/agent/*
DASHBOARD_PASSWORD=        # mật khẩu đăng nhập dashboard
SESSION_SECRET=            # ký cookie phiên (>= 32 ký tự ngẫu nhiên)

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=        # từ @BotFather
TELEGRAM_CHAT_ID=          # chat_id của bạn (từ @userinfobot / getUpdates)
TELEGRAM_WEBHOOK_SECRET=   # chuỗi ngẫu nhiên [A-Za-z0-9_-], 1-256 ký tự

# ---- GitHub (đối chiếu trạng thái runner) ----
GITHUB_TOKEN=              # PAT: Administration RW + Actions R (có thể dùng chung GH_PAT)
GITHUB_REPO=toilatrung/nutrimeal
RUNNER_NAME=colab-runner

# ---- Khác ----
COLAB_URL=https://colab.research.google.com/github/OWNER/REPO/blob/main/colab/colab_github_runner.ipynb
STALE_AFTER_SEC=300        # quá bấy lâu không có heartbeat => coi là dead
ALERT_REPEAT_SEC=1800      # nhắc lại khi vẫn dead
PUBLIC_URL=                # tuỳ chọn, vd https://ten-app.vercel.app (cho nút Dashboard)

# ---- Upstash Redis (Marketplace tự thêm một trong hai cặp) ----
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
